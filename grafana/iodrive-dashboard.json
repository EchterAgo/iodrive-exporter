        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "iodrive_temp_internal_celsius{instance=~\"$instance\",serial=~\"$serial\"}",
          "instant": true,
          "legendFormat": "{{instance}} {{serial}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Internal temp",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Live PCIe slot bus power draw.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
